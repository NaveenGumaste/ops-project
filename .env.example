# Copy this file to .env and set the local passwords before starting Docker Compose.
# For direct npm development, set DATABASE_URL to a PostgreSQL server reachable from this machine.
DATABASE_URL=

# Optional local PostgreSQL fallback settings used when DATABASE_URL is absent.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=inventory_db
PGHOST=localhost
PGPORT=5432

# Required by the local Grafana container.
GRAFANA_ADMIN_PASSWORD=
