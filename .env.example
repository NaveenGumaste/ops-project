# Neon PostgreSQL connection string.
# Copy this file to .env and replace the placeholder values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional local PostgreSQL fallback settings used when DATABASE_URL is absent.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=inventory_db
PGHOST=localhost
PGPORT=5432
